{
  "name": "eleet",
  "version": "1.1.0",
  "description": "Eleet — a zero-server studio for leet speak, classical ciphers, encodings, Unicode art, steganography and cryptanalysis. Everything runs in your browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Noormohammadiazad",
  "homepage": "https://eleet.ir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noormohammadiazad/Eleet.git"
  },
  "bugs": {
    "url": "https://github.com/Noormohammadiazad/Eleet/issues"
  },
  "keywords": [
    "leet",
    "1337",
    "cipher",
    "cryptography",
    "encoding",
    "steganography",
    "unicode",
    "enigma",
    "morse",
    "svelte"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
